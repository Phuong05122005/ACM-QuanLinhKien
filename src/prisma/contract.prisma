model User {
  id             String    @id @default(uuid())
  email          String    @unique
  password_hash  String
  full_name      String
  username       String    @unique
  student_code   String?   @unique
  created_at     DateTime  @default(now())
  updated_at     DateTime  @default(now())
  is_active      Boolean   @default(true)
  failed_attempts Int       @default(0)
  locked_until   DateTime?

  user_roles            UserRole[]
  loans                 Loan[]
  loan_status_histories LoanStatusHistory[]
  ai_reviews            AiReview[]
  disputes              Dispute[]
  notifications         Notification[]
  audit_logs            AuditLog[]

  @@map("users")
}

model Role {
  id          String     @id @default(uuid())
  name        String     @unique
  description String?

  user_roles  UserRole[]

  @@map("roles")
}

model UserRole {
  user_id String
  role_id String

  user User @relation(fields: [user_id], references: [id])
  role Role @relation(fields: [role_id], references: [id])

  @@id([user_id, role_id])
  @@map("user_roles")
}

model ComponentCategory {
  id          String      @id @default(uuid())
  name        String      @unique
  description String?

  components  Component[]

  @@map("component_categories")
}

model Component {
  id                 String    @id @default(uuid())
  name               String
  category_id        String
  total_quantity     Int       @default(0)
  available_quantity Int       @default(0)
  identifier         String    @unique
  created_at         DateTime  @default(now())

  category               ComponentCategory       @relation(fields: [category_id], references: [id])
  kit_components         KitComponent[]
  inventory_transactions InventoryTransaction[]
  loan_items             LoanItem[]

  @@map("components")
}

model Kit {
  id          String  @id @default(uuid())
  name        String
  description String?
  kit_code    String  @unique

  kit_components KitComponent[]

  @@map("kits")
}

model KitComponent {
  kit_id       String
  component_id String
  quantity     Int

  kit       Kit       @relation(fields: [kit_id], references: [id])
  component Component @relation(fields: [component_id], references: [id])

  @@id([kit_id, component_id])
  @@map("kit_components")
}

model QrCode {
  id          String @id @default(uuid())
  code        String @unique
  entity_type String
  entity_id   String

  @@map("qr_codes")
}

model InventoryTransaction {
  id               String   @id @default(uuid())
  component_id     String
  quantity_change  Int
  transaction_type String
  reference_id     String?
  created_at       DateTime @default(now())

  component Component @relation(fields: [component_id], references: [id])

  @@map("inventory_transactions")
}

model Loan {
  id         String   @id @default(uuid())
  user_id    String
  status     String
  due_date   DateTime
  loan_code  String   @unique
  created_at DateTime @default(now())
  updated_at     DateTime  @default(now())
  is_active      Boolean   @default(true)
  failed_attempts Int       @default(0)
  locked_until   DateTime?

  user                  User                @relation(fields: [user_id], references: [id])
  loan_items            LoanItem[]
  loan_status_histories LoanStatusHistory[]
  ai_scans              AiScan[]
  disputes              Dispute[]

  @@map("loans")
}

model LoanItem {
  id           String @id @default(uuid())
  loan_id      String
  component_id String
  quantity     Int

  loan      Loan      @relation(fields: [loan_id], references: [id])
  component Component @relation(fields: [component_id], references: [id])

  @@map("loan_items")
}

model LoanStatusHistory {
  id         String   @id @default(uuid())
  loan_id    String
  status     String
  changed_by String
  created_at DateTime @default(now())
  notes      String?

  loan Loan @relation(fields: [loan_id], references: [id])
  user User @relation(fields: [changed_by], references: [id])

  @@map("loan_status_histories")
}

model AiScan {
  id         String   @id @default(uuid())
  loan_id    String?
  image_url  String
  status     String
  created_at DateTime @default(now())

  loan              Loan?             @relation(fields: [loan_id], references: [id])
  ai_detected_items AiDetectedItem[]
  ai_reviews        AiReview[]

  @@map("ai_scans")
}

model AiDetectedItem {
  id                 String @id @default(uuid())
  scan_id            String
  detected_component String
  confidence_score   Float

  scan AiScan @relation(fields: [scan_id], references: [id])

  @@map("ai_detected_items")
}

model AiReview {
  id          String  @id @default(uuid())
  scan_id     String
  reviewer_id String
  decision    String
  comments    String?

  scan AiScan @relation(fields: [scan_id], references: [id])
  user User   @relation(fields: [reviewer_id], references: [id])

  @@map("ai_reviews")
}

model Dispute {
  id          String   @id @default(uuid())
  loan_id     String
  user_id     String
  status      String
  description String
  created_at  DateTime @default(now())

  loan              Loan              @relation(fields: [loan_id], references: [id])
  user              User              @relation(fields: [user_id], references: [id])
  dispute_evidences DisputeEvidence[]

  @@map("disputes")
}

model DisputeEvidence {
  id          String   @id @default(uuid())
  dispute_id  String
  file_url    String
  uploaded_at DateTime @default(now())

  dispute Dispute @relation(fields: [dispute_id], references: [id])

  @@map("dispute_evidences")
}

model Notification {
  id         String   @id @default(uuid())
  user_id    String
  type       String
  message    String
  is_read    Boolean  @default(false)
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id])

  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(uuid())
  user_id    String?
  action     String
  resource   String
  details    String
  ip_address String?
  created_at DateTime @default(now())

  user User? @relation(fields: [user_id], references: [id])

  @@map("audit_logs")
}

model SystemConfig {
  id         String   @id @default(uuid())
  key        String   @unique
  value      String
  updated_at     DateTime  @default(now())
  is_active      Boolean   @default(true)
  failed_attempts Int       @default(0)
  locked_until   DateTime?

  @@map("system_configs")
}
